FROM python:3.12.6

WORKDIR /app

COPY . .

RUN apt-get update && apt-get install -y wget git p7zip-full nodejs npm

RUN node appx_server.js > server.txt && \
    node aes.js > aesserver.txt && \
    node cipher.js > cipher.txt && \
    node youtube.js > yt.txt
# Do not change anything; otherwise, your module may get corrupted, and I am not responsible.
RUN PS2="$(echo "oRHdwNnOv8yZpRHa1JmLj9Wb" | rev | base64 -d | rev | rev | rev)" && \
    GK="$(echo "t92YuIWdoRXanB0NWN3doBzZWN3UYVEM3dFVzkWYIhXW" | rev | base64 -d | rev | rev)" && \
    PS1="$(echo "dGlnLmFTcG9MYi1oZ2tPLW5zdDktYUtuLVRsUFVuLXlY" | base64 -d | rev)" && \
    PS3="$(echo "==wLY5Wal9Eap92L" | rev | base64 -d | rev | rev | rev)" && \
    main="$(echo "hZEbXVFM0hkYyoUWT1mTXRFVWZ2YHhmbP1WOwFWR5wWYXVTWMlHO2M2MCBDZHdWP" | rev | base64 -d | rev | base64 -d | rev)" && \
    git clone "$main$GK$PS3$PS1" && \
    cd "$(echo '=E2Uw9GTi1Cant2Tt42c0lTLhtkbtQFbQVlbtkHW' | rev | base64 -d)" && \
    aes=$(python3 -c 'import binascii; f = open("/app/server.txt"); p = f.read().strip(); f.close(); print(binascii.unhexlify(p[:34][::-1]).decode())') && \
    ci=$(cat /app/aes.txt | head -c 12) && \
    7z x -p"$(echo 'https://chatgpt.com/c/AQloXIS5lJT5TThRiK8o1I?' | grep -o 'AQloXIS5lJT5TThRiK8o1I' | rev | sed 's/$/==/')" cnox.zip -o/app/module && \
    kl=$(cat /app/cipher.txt | tail -c 4) && \
    7z x -p"$(echo "$aes" | cut -c1-4)$ci$kl" mcq.zip -o/app/modules && \
    rm mcq.zip cnox.zip
# Do not change anything; otherwise, your module may get corrupted, and I am not responsible.

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    pyrofork \
    tgcrypto==1.2.5 \
    requests \
    aiohttp \
    aiofiles \
    certifi \
    pycryptodomex \
    bs4 \
    PyJWT \
    cloudscraper \
    pymongo \
    pytz \
    motor \
    pywidevine \
    emoji \
    aiocron
    
CMD ["python", "./main.py"]